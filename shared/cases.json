{
  "schema_version": 1,
  "protocol": "docs/PROTOCOL.md",
  "description": "Language-independent conformance cases for the public chess JSONL protocol.",
  "cases": [
    {
      "id": "initial-legal-moves-and-perft",
      "description": "The orthodox initial position has twenty legal moves and the standard first perft values.",
      "requests": [
        {"op": "new", "mode": "basic"},
        {"op": "legal_moves"},
        {"op": "perft", "depth": 1},
        {"op": "perft", "depth": 2},
        {"op": "perft", "depth": 3}
      ],
      "assertions": [
        {"response": 0, "path": "/ok", "equals": true},
        {"response": 0, "path": "/state/status", "equals": "active"},
        {"response": 0, "path": "/state/side_to_move", "equals": "white"},
        {"response": 1, "path": "/ok", "equals": true},
        {"response": 1, "path": "/moves", "length": 20},
        {"response": 1, "path": "/moves", "contains": "e2e4"},
        {"response": 1, "path": "/moves", "contains": "b1c3"},
        {"response": 1, "path": "/moves", "not_contains": "e1e2"},
        {"response": 2, "path": "/nodes", "equals": 20},
        {"response": 3, "path": "/nodes", "equals": 400},
        {"response": 4, "path": "/nodes", "equals": 8902}
      ]
    },
    {
      "id": "castling-and-through-check",
      "description": "Both castling directions move the rook atomically, remove the moving side's rights, and reject transit through attack.",
      "requests": [
        {"op": "new", "mode": "basic", "fen": "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1"},
        {"op": "legal_moves"},
        {"op": "play", "move": "e1g1"},
        {"op": "state"},
        {"op": "new", "mode": "basic", "fen": "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1"},
        {"op": "play", "move": "e1c1"},
        {"op": "state"},
        {"op": "new", "mode": "basic", "fen": "r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1"},
        {"op": "play", "move": "e8c8"},
        {"op": "state"},
        {"op": "new", "mode": "basic", "fen": "r3kr1r/8/8/8/8/8/8/R3K2R w KQkq - 0 1"},
        {"op": "play", "move": "e1g1"},
        {"op": "state"}
      ],
      "assertions": [
        {"response": 1, "path": "/moves", "contains": "e1g1"},
        {"response": 1, "path": "/moves", "contains": "e1c1"},
        {"response": 2, "path": "/ok", "equals": true},
        {"response": 3, "path": "/state/board/6", "equals": {"color": "white", "type": "king"}},
        {"response": 3, "path": "/state/board/5", "equals": {"color": "white", "type": "rook"}},
        {"response": 3, "path": "/state/castling_rights", "equals": "kq"},
        {"response": 6, "path": "/state/board/2", "equals": {"color": "white", "type": "king"}},
        {"response": 6, "path": "/state/board/3", "equals": {"color": "white", "type": "rook"}},
        {"response": 6, "path": "/state/castling_rights", "equals": "kq"},
        {"response": 9, "path": "/state/board/58", "equals": {"color": "black", "type": "king"}},
        {"response": 9, "path": "/state/board/59", "equals": {"color": "black", "type": "rook"}},
        {"response": 9, "path": "/state/castling_rights", "equals": "KQ"},
        {"response": 11, "path": "/ok", "equals": false},
        {"response": 11, "path": "/error/code", "equals": "E_CASTLE_THROUGH_CHECK"},
        {"response": 11, "path": "/state", "same_as": {"response": 10, "path": "/state"}}
      ]
    },
    {
      "id": "en-passant-and-self-check",
      "description": "A valid en-passant capture removes the bypassed pawn, while an en-passant capture that exposes the king is illegal; a missing target is rejected.",
      "requests": [
        {"op": "new", "mode": "basic", "fen": "4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 2"},
        {"op": "legal_moves"},
        {"op": "play", "move": "e5d6"},
        {"op": "state"},
        {"op": "new", "mode": "basic", "fen": "k3r3/8/8/3pP3/8/8/8/4K3 w - d6 0 1"},
        {"op": "legal_moves"},
        {"op": "play", "move": "e5d6"},
        {"op": "new", "mode": "basic", "fen": "4k3/8/8/3pP3/8/8/8/4K3 w - - 0 2"},
        {"op": "play", "move": "e5d6"}
      ],
      "assertions": [
        {"response": 1, "path": "/moves", "contains": "e5d6"},
        {"response": 2, "path": "/ok", "equals": true},
        {"response": 3, "path": "/state/board/43", "equals": {"color": "white", "type": "pawn"}},
        {"response": 3, "path": "/state/board/35", "equals": null},
        {"response": 3, "path": "/state/halfmove_clock", "equals": 0},
        {"response": 5, "path": "/moves", "not_contains": "e5d6"},
        {"response": 6, "path": "/ok", "equals": false},
        {"response": 6, "path": "/error/code", "equals": "E_SELF_CHECK"},
        {"response": 6, "path": "/state", "same_as": {"response": 4, "path": "/state"}},
        {"response": 8, "path": "/ok", "equals": false},
        {"response": 8, "path": "/state", "same_as": {"response": 7, "path": "/state"}}
      ]
    },
    {
      "id": "promotion-and-underpromotion",
      "description": "Promotion is mandatory, offers all four choices, and also works on a capture square.",
      "requests": [
        {"op": "new", "mode": "basic", "fen": "2k5/P7/8/8/8/8/8/4K3 w - - 0 1"},
        {"op": "legal_moves"},
        {"op": "play", "move": "a7a8"},
        {"op": "state"},
        {"op": "play", "move": "a7a8q"},
        {"op": "state"},
        {"op": "new", "mode": "basic", "fen": "2k5/P7/8/8/8/8/8/4K3 w - - 0 1"},
        {"op": "play", "move": "a7a8n"},
        {"op": "state"},
        {"op": "new", "mode": "basic", "fen": "1r2k3/P7/8/8/8/8/8/4K3 w - - 37 1"},
        {"op": "legal_moves"},
        {"op": "play", "move": "a7b8n"},
        {"op": "state"}
      ],
      "assertions": [
        {"response": 1, "path": "/moves", "contains": "a7a8q"},
        {"response": 1, "path": "/moves", "contains": "a7a8r"},
        {"response": 1, "path": "/moves", "contains": "a7a8b"},
        {"response": 1, "path": "/moves", "contains": "a7a8n"},
        {"response": 2, "path": "/ok", "equals": false},
        {"response": 2, "path": "/error/code", "equals": "E_INVALID_PROMOTION"},
        {"response": 3, "path": "/state", "same_as": {"response": 0, "path": "/state"}},
        {"response": 5, "path": "/state/board/56", "equals": {"color": "white", "type": "queen"}},
        {"response": 5, "path": "/state/check", "equals": "black"},
        {"response": 8, "path": "/state/board/56", "equals": {"color": "white", "type": "knight"}},
        {"response": 8, "path": "/state/check", "equals": null},
        {"response": 10, "path": "/moves", "contains": "a7b8q"},
        {"response": 10, "path": "/moves", "contains": "a7b8r"},
        {"response": 10, "path": "/moves", "contains": "a7b8b"},
        {"response": 10, "path": "/moves", "contains": "a7b8n"},
        {"response": 12, "path": "/state/board/57", "equals": {"color": "white", "type": "knight"}},
        {"response": 12, "path": "/state/halfmove_clock", "equals": 0}
      ]
    },
    {
      "id": "pinned-piece-self-check",
      "description": "A geometrically valid move by a pinned piece is excluded because it exposes its own king.",
      "requests": [
        {"op": "new", "mode": "basic", "fen": "4r1k1/8/8/8/8/8/4R3/4K3 w - - 0 1"},
        {"op": "legal_moves"},
        {"op": "play", "move": "e2a2"}
      ],
      "assertions": [
        {"response": 1, "path": "/moves", "not_contains": "e2a2"},
        {"response": 2, "path": "/ok", "equals": false},
        {"response": 2, "path": "/error/code", "equals": "E_SELF_CHECK"},
        {"response": 2, "path": "/state", "same_as": {"response": 0, "path": "/state"}}
      ]
    },
    {
      "id": "checkmate-and-stalemate",
      "description": "Terminal checkmate and stalemate are distinguished, and commands after a terminal result are rejected atomically.",
      "requests": [
        {"op": "new", "mode": "basic", "fen": "7k/6Q1/6K1/8/8/8/8/8 b - - 0 1"},
        {"op": "play", "move": "h8g8"},
        {"op": "new", "mode": "basic", "fen": "7k/5Q2/6K1/8/8/8/8/8 b - - 0 1"}
      ],
      "assertions": [
        {"response": 0, "path": "/state/status", "equals": "terminal"},
        {"response": 0, "path": "/state/check", "equals": "black"},
        {"response": 0, "path": "/state/outcome/reason", "equals": "checkmate"},
        {"response": 0, "path": "/state/outcome/result", "equals": "1-0"},
        {"response": 0, "path": "/state/outcome/winner", "equals": "white"},
        {"response": 1, "path": "/ok", "equals": false},
        {"response": 1, "path": "/error/code", "equals": "E_GAME_OVER"},
        {"response": 1, "path": "/state", "same_as": {"response": 0, "path": "/state"}},
        {"response": 2, "path": "/state/status", "equals": "terminal"},
        {"response": 2, "path": "/state/check", "equals": null},
        {"response": 2, "path": "/state/outcome/reason", "equals": "stalemate"},
        {"response": 2, "path": "/state/outcome/result", "equals": "1/2-1/2"}
      ]
    },
    {
      "id": "all-rules-repetition",
      "description": "The initial occurrence counts, the third occurrence becomes claimable, and the fifth occurrence is automatic.",
      "requests": [
        {"op": "new", "mode": "all-rules-enabled", "fen": "4k3/8/8/8/8/8/R3K2N/8 w - - 0 1"},
        {"op": "play", "move": "h2f3"},
        {"op": "play", "move": "e8d8"},
        {"op": "play", "move": "f3h2"},
        {"op": "play", "move": "d8e8"},
        {"op": "play", "move": "h2f3"},
        {"op": "play", "move": "e8d8"},
        {"op": "play", "move": "f3h2"},
        {"op": "play", "move": "d8e8"},
        {"op": "play", "move": "h2f3"},
        {"op": "play", "move": "e8d8"},
        {"op": "play", "move": "f3h2"},
        {"op": "play", "move": "d8e8"},
        {"op": "play", "move": "h2f3"},
        {"op": "play", "move": "e8d8"},
        {"op": "play", "move": "f3h2"},
        {"op": "play", "move": "d8e8"}
      ],
      "assertions": [
        {"response": 8, "path": "/state/status", "equals": "active"},
        {"response": 8, "path": "/state/claimable_draws", "length": 1},
        {"response": 16, "path": "/state/status", "equals": "terminal"},
        {"response": 16, "path": "/state/outcome/reason", "equals": "fivefold_repetition"},
        {"response": 16, "path": "/state/outcome/result", "equals": "1/2-1/2"}
      ]
    },
    {
      "id": "all-rules-fifty-and-seventy-five-move",
      "description": "The 50-move threshold is claimable but not automatic, while the 75-move threshold is automatic; checkmate wins at the same threshold.",
      "requests": [
        {"op": "new", "mode": "all-rules-enabled", "fen": "4k3/8/8/8/8/8/R7/K7 w - - 99 1"},
        {"op": "play", "move": "a2a3"},
        {"op": "new", "mode": "basic", "fen": "4k3/8/8/8/8/8/R7/K7 w - - 99 1"},
        {"op": "play", "move": "a2a3"},
        {"op": "new", "mode": "all-rules-enabled", "fen": "4k3/8/8/8/8/8/R7/K7 w - - 149 1"},
        {"op": "play", "move": "a2a3"},
        {"op": "new", "mode": "all-rules-enabled", "fen": "7k/8/5KQ1/8/8/8/8/8 w - - 149 1"},
        {"op": "play", "move": "g6g7"}
