        {"response": 3, "path": "/state/status", "equals": "active"},
        {"response": 3, "path": "/state/halfmove_clock", "equals": 100},
        {"response": 3, "path": "/state/claimable_draws", "length": 0},
        {"response": 5, "path": "/state/status", "equals": "terminal"},
        {"response": 5, "path": "/state/halfmove_clock", "equals": 150},
        {"response": 5, "path": "/state/outcome/reason", "equals": "seventy_five_move"},
        {"response": 5, "path": "/state/outcome/result", "equals": "1/2-1/2"},
        {"response": 7, "path": "/state/status", "equals": "terminal"},
        {"response": 7, "path": "/state/outcome/reason", "equals": "checkmate"},
        {"response": 7, "path": "/state/outcome/result", "equals": "1-0"}
      ]
    },
    {
      "id": "deterministic-run-and-sample",
      "description": "The public CPU run and root sampler are repeatable for a fixed seed and must agree across engines.",
      "requests": [
        {"op": "new", "mode": "all-rules-enabled", "seed": "42"},
        {"op": "sample", "samples": 64, "seed": "42"},
        {"op": "state"},
        {"op": "run", "mode": "all-rules-enabled", "seed": "42", "max_plies": 24},
        {"op": "run", "mode": "all-rules-enabled", "seed": "42", "max_plies": 24},
        {"op": "sample", "samples": 64, "seed": "42"}
      ],
      "assertions": [
        {"response": 1, "path": "/ok", "equals": true},
        {"response": 1, "path": "/seed", "equals": "42"},
        {"response": 1, "path": "/samples", "equals": 64},
        {"response": 1, "path": "/moves", "length": 20},
        {"response": 2, "path": "/state", "same_as": {"response": 0, "path": "/state"}},
        {"response": 3, "path": "/seed", "equals": "42"},
        {"response": 4, "path": "", "same_as": {"response": 3, "path": ""}},
        {"response": 5, "path": "", "same_as": {"response": 1, "path": ""}}
      ]
    },
